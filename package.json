    "compression-webpack-plugin": "5.0.2",
    "connect": "3.6.6",
    "eslint": "6.8.0",
    "eslint-plugin-vue": "7.2.0",
    "highlight.js": "10.4.1",
    "less": "3.13.1",
    "less-loader": "^5.0.0",
    "lint-staged": "10.5.3",
    "postcss": "^8.0.9",
